# X Layer RPC endpoint
RPC_URL=https://rpc.xlayer.tech

# Keeper wallet private key (never commit the real key)
KEEPER_PRIVATE_KEY=0xyour_private_key_here

# JobRegistry contract address (set after deployment)
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Polling interval in milliseconds (default: every new block ~2s)
# Set to 0 to use block-driven mode (recommended)
POLL_INTERVAL_MS=0

# Max gas price in gwei to submit transactions (skip if above this)
MAX_GAS_PRICE_GWEI=50

# Log level: debug | info | warn | error
LOG_LEVEL=info
